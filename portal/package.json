{
  "name": "kbmcp-web",
  "version": "0.1.0",
  "private": true,
  "description": "hyseed product portal — static, trilingual, deployed to Cloudflare Pages",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "og": "node scripts/generate-og.mjs",
    "prebuild": "node scripts/generate-og.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler pages dev out",
    "deploy": "npm run build && wrangler pages deploy out --project-name hyseed-portal --branch main"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.0",
    "wrangler": "4.155.0"
  }
}